# PHM Docker 환경 설정 예시
# 이 파일을 복사하여 .env 로 저장하세요: cp .env.example .env

# ── PyTorch 빌드 대상 ────────────────────────────────────────────────────────
# cpu    → CPU 전용 (기본값, .env 없어도 동작)
# cu121  → CUDA 12.1 (NVIDIA 드라이버 ≥ 525)
# cu118  → CUDA 11.8 (NVIDIA 드라이버 ≥ 450)
TORCH_DEVICE=cpu

# ── GPU 사용 시 추가 설정 (TORCH_DEVICE=cu121 또는 cu118 일 때) ──────────────
# docker compose 실행 시 docker-compose.gpu.yml 도 함께 로드:
#   Windows: COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
#   Linux/Mac: COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# 또는 매번 명시적으로:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
